```DAX
Won Deals US vs P-1 =
VAR MoisNum =
    MAX ( 'Calendar'[Month num] )

VAR TrimText =
    MAX ( 'Calendar'[Quarter No] )

VAR SemText =
    MAX ( 'Calendar'[Semester No] )

VAR AnneeNum =
    VALUE ( MAX ( 'Calendar'[Year Name] ) )

VAR previousValue =
    SWITCH (
        TRUE (),

        -- =========================
        -- MOIS
        -- =========================
        ISFILTERED ( 'Calendar'[Month & Year] ),

            VAR mPrec =
                IF ( MoisNum = 1, 12, MoisNum - 1 )

            VAR yPrec =
                IF ( MoisNum = 1, AnneeNum - 1, AnneeNum )

            RETURN
                CALCULATE (
                    [Won Deals USD],
                    REMOVEFILTERS ( 'Calendar' ),
                    'Calendar'[Month num] = mPrec,
                    'Calendar'[Year Name] = FORMAT ( yPrec, "0" )
                ),

        -- =========================
        -- TRIMESTRE
        -- =========================
        ISFILTERED ( 'Calendar'[Quarter & Year] ),

            VAR qPrec =
                SWITCH (
                    TrimText,
                    "1", "4",
                    "2", "1",
                    "3", "2",
                    "4", "3"
                )

            VAR yPrec2 =
                IF (
                    TrimText = "1",
                    AnneeNum - 1,
                    AnneeNum
                )

            RETURN
                CALCULATE (
                    [Won Deals USD],
                    REMOVEFILTERS ( 'Calendar' ),
                    'Calendar'[Quarter No] = qPrec,
                    'Calendar'[Year Name] = FORMAT ( yPrec2, "0" )
                ),

        -- =========================
        -- SEMESTRE
        -- =========================
        ISFILTERED ( 'Calendar'[Semester Name] ),

            VAR sPrec =
                SWITCH (
                    SemText,
                    "1", "2",
                    "2", "1"
                )

            VAR yPrec3 =
                IF (
                    SemText = "1",
                    AnneeNum - 1,
                    AnneeNum
                )

            RETURN
                CALCULATE (
                    [Won Deals USD],
                    REMOVEFILTERS ( 'Calendar' ),
                    'Calendar'[Semester No] = sPrec,
                    'Calendar'[Year Name] = FORMAT ( yPrec3, "0" )
                ),

        -- =========================
        -- ANNÉE
        -- =========================
        ISFILTERED ( 'Calendar'[Year Name] ),

            CALCULATE (
                [Won Deals USD],
                REMOVEFILTERS ( 'Calendar' ),
                'Calendar'[Year Name] =
                    FORMAT ( AnneeNum - 1, "0" )
            ),

        BLANK ()
    )

RETURN
    IF (
        ISBLANK ( previousValue )
            || previousValue = 0,
        BLANK (),
        DIVIDE (
            [Won Deals USD] - previousValue,
            previousValue
        )
    )
