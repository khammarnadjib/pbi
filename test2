Won Deals US vs P-1 =
VAR MoisNum =
    MAX ( 'Calendar'[Month num] )
VAR TrimNum =
    MAX ( 'Calendar'[Quarter No] )
VAR SemNum =
    MAX ( 'Calendar'[Semester No] )
VAR AnneeNum =
    VALUE ( MAX ( 'Calendar'[Year Name] ) )

VAR previousValue =
    SWITCH (
        TRUE (),

        -- Mois
        ISFILTERED ( 'Calendar'[Month & Year] ),
            VAR mPrec =
                IF ( MoisNum = 1, 12, MoisNum - 1 )
            VAR yPrec =
                IF ( MoisNum = 1, AnneeNum - 1, AnneeNum )
            RETURN
                CALCULATE (
                    [Won Deals USD],
                    REMOVEFILTERS ( 'Calendar' ),
                    'Calendar'[Month num] = mPrec,
                    'Calendar'[Year Name] = FORMAT ( yPrec, "0" )
                ),

        -- Trimestre
        ISFILTERED ( 'Calendar'[Quarter & Year] ),
            VAR qPrec =
                IF ( TrimNum = 1, 4, TrimNum - 1 )
            VAR yPrec =
                IF ( TrimNum = 1, AnneeNum - 1, AnneeNum )
            RETURN
                CALCULATE (
                    [Won Deals USD],
                    REMOVEFILTERS ( 'Calendar' ),
                    'Calendar'[Quarter No] = qPrec,
                    'Calendar'[Year Name] = FORMAT ( yPrec, "0" )
                ),

        -- Semestre
        ISFILTERED ( 'Calendar'[Semester Name] ),
            VAR sPrec =
                IF ( SemNum = 1, 2, 1 )
            VAR yPrec =
                IF ( SemNum = 1, AnneeNum - 1, AnneeNum )
            RETURN
                CALCULATE (
                    [Won Deals USD],
                    REMOVEFILTERS ( 'Calendar' ),
                    'Calendar'[Semester No] = sPrec,
                    'Calendar'[Year Name] = FORMAT ( yPrec, "0" )
                ),

        -- Année
        ISFILTERED ( 'Calendar'[Year Name] ),
            CALCULATE (
                [Won Deals USD],
                REMOVEFILTERS ( 'Calendar' ),
                'Calendar'[Year Name] = FORMAT ( AnneeNum - 1, "0" )
            ),

        -- Aucun filtre temporel explicite
        BLANK ()
    )

RETURN
    IF (
        ISBLANK ( previousValue )
            || previousValue = 0,
        BLANK (),
        DIVIDE (
            [Won Deals USD] - previousValue,
            previousValue
        )
    )
